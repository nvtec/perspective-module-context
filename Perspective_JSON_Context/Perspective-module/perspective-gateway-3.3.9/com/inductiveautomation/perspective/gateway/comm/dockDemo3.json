  "mounts": {
    "/": {
      "view": "centerView",
      "docks": []
    }
  },
  "docks": {
    "showHandleDuration": 5000,
    "cornerPriority": "left-right",
    "left": {
      "display": {
        "show": "auto",
        "anchor": "fixed",
        "content": "push"
      },
      "resizable": false,
      "autoBreakpoint": 800,
      "handleHideConfig": "always",
      "defaultViewIndex": 0,
      "views": [
        {
          "view": "sideView",
          "size": 208
        }
      ]
    },
    "top": {
      "display": {
        "show": "visible",
        "anchor": "scrollable",
        "content": "cover"
      },
      "resizable": false,
      "handleHideConfig": "always",
      "views": [
        {
          "view": "topView",
          "size": 144
        }
      ]
    },
    "right": {
      "display": {
        "show": "onDemand",
        "anchor": "fixed",
        "content": "cover"
      },
      "resizable": false,
      "handleHideConfig": "inactive",
      "views": [
        {
          "view": "sideView",
          "size": 208,
          "iconUrl": "/main/res/perspective/icons/material-icons.svg#rowing"
        },
        {
          "view": "topView",
          "size": 144,
          "iconUrl": "/main/res/perspective/icons/material-icons.svg#audiotrack",
          "isModal": true
        }
      ]
    },
    "bottom": {
      "display": {
        "show": "onDemand",
        "anchor": "fixed",
        "content": "cover"
      },
      "handleHideConfig": "inactive",
      "views": [
        {
          "view": "topView",
          "size": 144
        }
      ]
    }
