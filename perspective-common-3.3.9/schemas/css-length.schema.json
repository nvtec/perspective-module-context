{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "Perspective css length values.",
    "oneOf": [
        {
            "type": "string",
            "pattern": "^(auto|0)$|^[+-]?[0-9]+.?([0-9]+)?(px|em|ex|%|in|cm|mm|pt|pc|rem)$"
        },
        {
            "type": "number"
        }
    ]
}
